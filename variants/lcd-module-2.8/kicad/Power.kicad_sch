(title_block (title "USB-C power input and protection") (date "2026-11-08") (rev "0.0.11-dev") (company "ShieldSigner / LightningSpore") (comment 1 "Derived from 3rdIteration/SeedSigner; original design: Stephen Rothy") (comment 2 "Prototype: physical fit, powered operation and assembly not qualified"))
(text "USB-C 5 V input, bypass and protection" (at 25.4 25.4 0) (effects (font (size 2 2) (bold yes)) (justify left)) (uuid "5524cecd-0ad3-5ea5-b89e-bbcbdaf850a3"))
(text "Power only: USB data is not connected. Follow +5V to the host, reader and display regulator." (at 25.4 33.02 0) (effects (font (size 1.27 1.27) ) (justify left)) (uuid "238105b9-6a3c-5cd9-b8e0-eb559fbded9e"))
(text "USB-C sink identification\nR301 / R302: 5.1 kOhm to GND\nEach CC pin has its own pull-down." (at 25.4 109.22 0) (effects (font (size 1.27 1.27) ) (justify left)) (uuid "5efd111a-51a7-5b45-a8a7-5ce0f2800b20"))
(text "Input bypass and transient protection\nC301: 100 nF; C302: 10 uF\nD301: SMF5.0CA TVS across the 5 V rail." (at 104.14 109.22 0) (effects (font (size 1.27 1.27) ) (justify left)) (uuid "89d80b69-00dc-514e-ad13-94a8909b62e1"))



