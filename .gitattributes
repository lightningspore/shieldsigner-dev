# Manufacturer/supplier reference PDFs use this repository’s Git LFS endpoint.
*.pdf filter=lfs diff=lfs merge=lfs -text
# Portable mechanical models and review assemblies.
*.step filter=lfs diff=lfs merge=lfs -text
*.stp filter=lfs diff=lfs merge=lfs -text
# Bundled upstream GLSL strings retain their intentional shader whitespace.
website/static/enclosure-viewer.js -whitespace
# Preserve upstream license bytes exactly for their pinned checksum receipts.
scripts/image-licenses/** -whitespace

# Source-owned reusable tscircuit CAD assets.
src/pill/models/*.glb filter=lfs diff=lfs merge=lfs -text

# Native full-size Pico web assembly.
variants/full-size-pico/assembly.glb filter=lfs diff=lfs merge=lfs -text
variants/full-size-pico/manufacturing/shieldsigner-full-pico-prototype-10.zip filter=lfs diff=lfs merge=lfs -text
# Preserve native KiCad serializer whitespace and reviewed source bytes.
variants/full-size-pico/kicad/*.kicad_sch -whitespace
variants/full-size-pico/kicad/*.kicad_sym -whitespace
