(title_block (title "Host module and configuration") (date "2026-11-08") (rev "0.0.11-dev") (company "ShieldSigner / LightningSpore") (comment 1 "Derived from 3rdIteration/SeedSigner; original design: Stephen Rothy") (comment 2 "Prototype: physical fit, powered operation and assembly not qualified"))
(text "Host module, signal mapping and assembly straps" (at 17.78 20.32 0) (effects (font (size 2 2) (bold yes)) (justify left)) (uuid "4f33c416-81f4-5a60-9052-e348b90b661b"))
(text "U202 is fitted. U201 is a schematic-only legacy interface reference; it is not a second module or an assembly part." (at 17.78 27.94 0) (effects (font (size 1.1 1.1) ) (justify left)) (uuid "3ead2edd-df6e-57db-abbf-1e2a7b38277c"))
(text "LEGACY INTERFACE REFERENCE ONLY\nU201 and TP201 have no PCB footprint." (at 17.78 58.42 0) (effects (font (size 1.1 1.1) (bold yes)) (justify left)) (uuid "bb4e35b2-00b3-5cba-90f8-b35fdafb20c2"))
(text "FACTORY STRAP TABLE\nJP201 closed / JP202 open: backlight held high\nJP203 closed / JP204 open: GPIO1_C0 drives CS\nJP205 closed / JP206 open: GPIO-controlled CS\nNever close both alternatives in a strap pair." (at 17.78 151.13 0) (effects (font (size 1.1 1.1) ) (justify left)) (uuid "add6ae6a-daa5-516c-a2d8-fba03488c631"))
(text "BACKLIGHT SOURCE\nJP202 selects MCU_BACKLIGHT only in an alternate configuration.\nThis PCB has no dedicated host PWM path; use the separate PWM candidate." (at 116.84 152.4 0) (effects (font (size 1.0 1.0) ) (justify left)) (uuid "90d68275-bd44-5416-85c0-5887c2a35020"))
(text "HOST FIRMWARE\nUse the carrier GPIO map and 320 x 240 display profile.\nThe 240 x 240 bench image conflicts with two button nets." (at 116.84 172.72 0) (effects (font (size 1.0 1.0) ) (justify left)) (uuid "41b45b00-74fd-5e2f-a460-f873fd73262c"))
(text "BACKLIGHT: default high" (at 116.84000 34.29000 0) (effects (font (size 1.1 1.1) (bold yes)) (justify left)) (uuid "db1b5eda-8391-5eae-bc44-ec9ec0dbad29"))
(text "CHIP SELECT: default GPIO" (at 203.2 38.1 0) (effects (font (size 1.1 1.1) (bold yes)) (justify left)) (uuid "3cfbc081-df1b-56f3-b315-13adb735994f"))
(text "GPIO1_C0 FUNCTION" (at 124.46000 92.71000 0) (effects (font (size 1.1 1.1) (bold yes)) (justify left)) (uuid "fec63235-dec1-5cc0-8217-ad0099ecfc65"))
