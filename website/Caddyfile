:{$PORT:8080} {
    encode zstd gzip
    header {
        X-Content-Type-Options nosniff
        Referrer-Policy strict-origin-when-cross-origin
        X-Frame-Options DENY
    }
    root * /srv
    @health path /healthz
    header @health Content-Type application/json
    @files path /files/*
    header @files Cache-Control no-cache
    @download {
        path /files/*
        not path *.pdf *.svg *.png
    }
    header @download Content-Disposition attachment
    file_server
    handle_errors {
        rewrite * /404.html
        file_server
    }
}
