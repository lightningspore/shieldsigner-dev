:80 {
    encode zstd gzip
    header {
        X-Content-Type-Options nosniff
        Referrer-Policy strict-origin-when-cross-origin
        X-Frame-Options DENY
    }
    reverse_proxy web:8000 {
        header_up X-Forwarded-Proto https
        health_uri /healthz
        health_interval 5s
        health_timeout 3s
        health_headers {
            Host shieldsigner.dev
        }
    }
}
